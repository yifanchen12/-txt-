{
  "name": "novel-archive-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "android": "npm run build && cap sync android",
    "ios": "npm run build && cap sync ios",
    "desktop": "npm run build && electron desktop/main.mjs",
    "package:windows": "npm run build && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "page-flip": "^2.0.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@electron/packager": "20.3.0",
    "electron": "45.2.1",
    "fake-indexeddb": "^6.0.0",
    "linkedom": "^0.18.12",
    "vite": "^7.1.0"
  }
}
